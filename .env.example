# Copy to .env.local. Values are read only by the Node server.
# The unchanged Emma/Bupa example runs without any model credentials.
TEXT_PROVIDER=openai
SPEECH_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
# For the existing Vertex adapters, select vertex above and supply your own
# deployed MedGemma/MedASR prediction URLs. Authenticate gcloud with ADC.
MEDGEMMA_ENDPOINT_URL=
MEDASR_ENDPOINT_URL=
# Optional Google Calendar OAuth client. Register this exact local callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4175/api/google/callback
