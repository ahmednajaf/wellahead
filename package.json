{
  "name": "wellahead",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm --prefix frontend ci",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "start": "node server/server.mjs",
    "test": "npm run build && npm run test:server && npm --prefix frontend test",
    "test:server": "node --import ./scripts/test-env.mjs --test server/tests/*.test.mjs",
    "test:browser": "npm --prefix frontend run test:browser"
  }
}
